# Production build environment (used by `npm run build` only — vite loads
# .env.production for mode=production and it overrides .env, so `npm run dev`
# keeps using the localhost values in .env).
#
# NOTE: VITE_API_URL must end with a trailing slash — the code concatenates
# paths directly onto it (e.g. `${API_BASE_URL}api/AttendanceRegularization`).

# Backend API (prod)
VITE_API_URL=https://v2parivar.v2retail.com:9987/

# Secondary API base used by src/services/axiosInstance2.jsx
VITE_API_URL_2=https://v2parivar.v2retail.com:9987/

# Optional: only needed for the resume/document OCR in the candidate forms
VITE_OPENAI_API_KEY=
