# Production build environment (used by `npm run build` only — vite loads
# .env.production for mode=production and it overrides .env, so `npm run dev`
# keeps using the localhost values in .env).
#
# NOTE: VITE_API_URL must end with a trailing slash — the code concatenates
# paths directly onto it (e.g. `${API_BASE_URL}api/AttendanceRegularization`).

# Backend API (prod)
VITE_API_URL=https://v2parivar.v2retail.com:9987/

# Secondary API base used by src/services/axiosInstance2.jsx
VITE_API_URL_2=https://v2parivar.v2retail.com:9987/

# Candidate list page size — MUST stay empty here.
#
# .env sets this to 300 for local dev (the endpoint is slow against the dev
# server). Vite layers .env.production ON TOP of .env, so anything .env sets and
# this file does not override still reaches the prod bundle — which is how the
# 03-Sep-2026 build shipped with pageSize=300 and left the Candidate List showing
# only the newest 300 of 4,403 candidates, i.e. nothing created before 04-Sep.
#
# Empty is deliberate, not an oversight: Services.js reads
# `Number(import.meta.env.VITE_CANDIDATE_LIST_PAGE_SIZE) || 100000`, and
# Number('') is 0 -> falsy -> the 100000 default applies. Do not delete this line;
# without it the value silently falls back to whatever .env holds.
VITE_CANDIDATE_LIST_PAGE_SIZE=

# Optional: only needed for the resume/document OCR in the candidate forms
VITE_OPENAI_API_KEY=
